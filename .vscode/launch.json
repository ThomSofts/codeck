{
  // ▶ "Codeck (dev)": sobe o backend em depuração (porta 47822, dados em data-sandbox/) e abre o app nativo
  // conectado nele — sem tocar no app instalado nem nas suas contas reais. O Codeck só roda como app de desktop.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (depurar)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/server.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "CODECK_PORT": "47822",
        "CODECK_DATA": "${workspaceFolder}/data-sandbox",
        "CODECK_TOKEN_FILE": "${workspaceFolder}/data-sandbox/dev-token",
        "CODECK_NATIVE_NOTIFY": "1"
      }
    },
    {
      "name": "App macOS (conecta no backend em depuração)",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Compilar app macOS",
      "command": "CODECK_ATTACH=1 CODECK_PORT=47822 CODECK_TOKEN_FILE=\"${workspaceFolder}/data-sandbox/dev-token\" \"${workspaceFolder}/dist/Codeck.app/Contents/MacOS/Codeck\""
    },
    {
      "name": "App Windows (conecta no backend em depuração)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Compilar app Windows",
      "program": "${workspaceFolder}/windows/Codeck/bin/Debug/net8.0-windows/win-x64/Codeck.exe",
      "cwd": "${workspaceFolder}",
      "env": { "CODECK_ATTACH": "1", "CODECK_PORT": "47822", "CODECK_TOKEN_FILE": "${workspaceFolder}/data-sandbox/dev-token" }
    },
    {
      "name": "Instalar o app no meu Mac",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash scripts/build-macos.sh"
    }
  ],
  "compounds": [
    { "name": "Codeck (dev, macOS)", "configurations": ["Backend (depurar)", "App macOS (conecta no backend em depuração)"], "stopAll": true },
    { "name": "Codeck (dev, Windows)", "configurations": ["Backend (depurar)", "App Windows (conecta no backend em depuração)"], "stopAll": true }
  ]
}
